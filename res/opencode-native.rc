// Resources of opencode-native.exe.
//   id 1, ICON         the exe icon (Explorer, shortcuts, Settings > Apps) and the window / taskbar icon
//                      (platform.open_window loads id 1). Generated by tools\make_logo.ps1.
//   id 1, VERSIONINFO  publisher, product and version (Properties > Details). The numbers come from APP_VERSION
//                      (src\setup.odin) through build\version.h, written by build.bat.
//   id 1, RT_MANIFEST  runs as the invoking user, declares Windows 10 and 11, per-monitor DPI aware.
#include "../build/version.h"

1 ICON "..\\assets\\opencode-native.ico"
1 24 "opencode-native.manifest"

1 VERSIONINFO
FILEVERSION OCC_VER_MAJOR, OCC_VER_MINOR, OCC_VER_PATCH, 0
PRODUCTVERSION OCC_VER_MAJOR, OCC_VER_MINOR, OCC_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Froment Software"
            VALUE "FileDescription", "opencode native"
            VALUE "FileVersion", OCC_VER_STRING
            VALUE "InternalName", "opencode-native"
            VALUE "LegalCopyright", "Copyright (c) 2026 Sacha Froment (Froment Software)"
            VALUE "OriginalFilename", "opencode-native.exe"
            VALUE "ProductName", "opencode native"
            VALUE "ProductVersion", OCC_VER_STRING
            VALUE "Comments", "A native desktop client for the opencode server"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
